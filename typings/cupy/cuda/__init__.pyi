from __future__ import annotations

from collections.abc import Callable

from . import runtime as runtime

class MemoryPointer: ...

type Allocator = Callable[[int], MemoryPointer]

class Device:
    def __init__(self, device: int | None = ...) -> None: ...
    def use(self) -> None: ...

class MemoryPool:
    def __init__(self, allocator: Allocator | None = ...) -> None: ...
    def malloc(self, size: int) -> MemoryPointer: ...
    def set_limit(self, size: int | None = ..., fraction: float | None = ...) -> None: ...
    def get_limit(self) -> int: ...
    def used_bytes(self) -> int: ...
    def total_bytes(self) -> int: ...
    def free_all_blocks(self) -> None: ...

class Stream:
    def synchronize(self) -> None: ...

def get_allocator() -> Allocator: ...
def set_allocator(allocator: Allocator | None = ...) -> None: ...
def get_current_stream() -> Stream: ...
