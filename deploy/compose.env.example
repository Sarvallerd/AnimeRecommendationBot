# Pass with: docker compose --env-file deploy/compose.env.example -p animebot ...
# Set ARB_BUNDLE_DIR to the published host bundle path before starting prepare/bot.
ARB_DATA_DIR=./.arb/data
ARB_BUNDLE_DIR=./.arb/bundle-not-selected
ARB_UID=1000
ARB_GID=1000
ARB_LOG=info
ARB_BOT_ENV=./deploy/.env.bot
ARB_POSTGRES_ENV=./deploy/.env.postgres
